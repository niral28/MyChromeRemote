{
  "manifest_version": 3,
  "name": "TV Remote Browser Bridge",
  "version": "0.1.0",
  "description": "Relays local TV Remote commands to Hulu and Disney+ tabs.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "MyChromeRemote Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "tabs", "windows"],
  "host_permissions": ["https://www.hulu.com/*", "https://www.disneyplus.com/*", "https://www.peacocktv.com/*", "https://tv.apple.com/*", "https://www.youtube.com/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://www.hulu.com/*", "https://www.disneyplus.com/*", "https://www.peacocktv.com/*", "https://tv.apple.com/*", "https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
